# Copy to .env.local and fill in. Never commit .env.local.

# Anthropic — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Model used for extraction/reasoning (default: claude-sonnet-5)
ANTHROPIC_MODEL=claude-sonnet-5
# Reasoning effort: low | medium | high (default: medium)
ANTHROPIC_EFFORT=medium

# Firecrawl — https://www.firecrawl.dev/app/api-keys
FIRECRAWL_API_KEY=

# Exa — https://dashboard.exa.ai/api-keys
EXA_API_KEY=

# Hunter.io — https://hunter.io/api-keys
HUNTER_API_KEY=

# Pipeline tuning (optional)
ENRICH_CONCURRENCY=5
# Max characters of scraped markdown kept per page before sending to Claude
ENRICH_MAX_PAGE_CHARS=12000
