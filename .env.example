# Copy to .env.local and fill in. Never commit .env.local.
#
# FREE SETUP (no credit card): GEMINI_API_KEY + EXA_API_KEY + HUNTER_API_KEY.
# Company websites are fetched directly unless FIRECRAWL_API_KEY is set.

# --- LLM: set ONE of these -------------------------------------------------
# Google Gemini, free tier — https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Comma-separated, tried in order: if a model is overloaded (503), retired (404)
# or out of quota, calls fall through to the next one. Unknown names are skipped.
GEMINI_MODEL=gemini-flash-latest,gemini-3.8-flash,gemini-flash-lite-latest
# Free tier is roughly 10 requests/minute; calls are spaced to stay under it
GEMINI_RPM=10

# Anthropic Claude, paid — https://console.anthropic.com/settings/keys
# If both keys are set, Claude is used unless LLM_PROVIDER=gemini.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# low | medium | high
ANTHROPIC_EFFORT=medium

# Force a provider: anthropic | gemini (optional)
LLM_PROVIDER=

# --- Search & email ------------------------------------------------------------
# Exa, free $10/month credit — https://dashboard.exa.ai/api-keys
EXA_API_KEY=
# Hunter.io, free 50 credits/month — https://hunter.io/api-keys
HUNTER_API_KEY=

# --- Optional -------------------------------------------------------------------
# Firecrawl renders JavaScript-heavy sites better than direct fetch (free 500 credits)
FIRECRAWL_API_KEY=
ENRICH_CONCURRENCY=5
# Max characters kept per scraped page
ENRICH_MAX_PAGE_CHARS=12000
# Results persist to .enrich-cache.json so re-runs are instant and free; 0 disables
ENRICH_DISK_CACHE=1
